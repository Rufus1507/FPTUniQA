{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FPTUniQA Entity Schema",
  "type": "object",
  "required": [
    "entity_id",
    "entity_type",
    "canonical_name",
    "canonical_name_vi",
    "aliases",
    "status",
    "verified",
    "confidence",
    "source_reference"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$",
      "description": "Unique identifier, uppercase with underscores"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "major",
        "course",
        "cohort",
        "campus",
        "academic_term",
        "abbreviation"
      ]
    },
    "code": {
      "type": "string",
      "description": "Official code (e.g. MOET major code, course code, campus code)"
    },
    "canonical_name": {
      "type": "string",
      "description": "Standard English/international name"
    },
    "canonical_name_vi": {
      "type": "string",
      "description": "Standard official Vietnamese name with accents"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Variations, synonyms, abbreviations, accentless forms"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "provisional"
      ]
    },
    "verified": {
      "type": "boolean",
      "description": "True if confirmed by repository documents"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "source_reference": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "valid_from": {
      "type": ["string", "null"]
    },
    "valid_to": {
      "type": ["string", "null"]
    },
    "disambiguation_rules": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  }
}
