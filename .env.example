# ==============================================================================
# CẤU HÌNH MẪU MÔI TRƯỜNG DỰ ÁN UNIVERSITY QA (FPTUniQA)
# ==============================================================================

# Cấu hình máy chủ LLM API (OpenAI Compatible Endpoint)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_llm_api_key_here
MODEL_NAME=gemini/gemini-3.5-flash-lite
LLM_TIMEOUT=60

# Cấu hình máy chủ FastAPI Backend
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Cấu hình Frontend Streamlit kết nối tới API
API_BASE_URL=http://localhost:8000

# Cấu hình Pipeline & Logs
DEFAULT_TOP_K=5
LOG_DIR=logs
