# ==============================================================================
# UNIVERSITY-QA ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server & Application settings
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Model Configurations
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
RERANKER_MODEL_NAME=BAAI/bge-reranker-large
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Paths configuration
CONFIG_PATH=configs/development.yaml
CORPUS_PATH=data/processed/corpus.jsonl
STRUCTURED_DATA_PATH=data/processed/structured_data.json
METADATA_PATH=data/processed/metadata.json
FAISS_INDEX_DIR=data/processed/faiss_index
BM25_INDEX_DIR=data/processed/bm25_index
