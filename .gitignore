# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches & Test artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
htmlcov/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments & uv
.venv/
venv/
env/
ENV/
.uv/

# Environment variables & secrets (TUYỆT ĐỐI KHÔNG PUSH .env)
.env
.env.*
!.env.example
*.pem
*.key

# Data rules: Raw and interim data are ignored
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Processed indexes (large binary files, rebuilt from corpus)
data/processed/bm25_index/
data/processed/faiss_index/

# Model weights & large vector indexes
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.faiss
*.index
*.pkl

# Logs & temporary response files (Chỉ giữ lại file rỗng .gitkeep)
logs/*
!logs/.gitkeep
*.log
*.jsonl
!data/processed/*.jsonl
!data/evaluation/*.jsonl
!tests/fixtures/*.jsonl
response*.json
scratch/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
