# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments & uv
.venv
.venv/
venv/
env/
ENV/
.uv/
uv.lock

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data rules: Do not commit raw or interim data files
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Model weights & large vector indexes
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.faiss
*.index
*.pkl

# Logs
logs/*
!logs/.gitkeep
*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
